# Exemplo local. Use uma senha propria e exporte a variavel no terminal.
# O Cabal nao carrega arquivos .env automaticamente.
DATABASE_URL=postgresql://postgres:SUA_SENHA@localhost:5432/power_system
APP_BASE_URL=http://localhost:5173
GOOGLE_CLIENT_ID=SEU_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=SEU_CLIENT_SECRET
