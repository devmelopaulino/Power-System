cabal-version: 2.4
name: power-system
version: 0.1.0.0
synopsis: Base Haskell do Power System
build-type: Simple
extra-source-files: migrations/*.sql

common common-options
  default-language: Haskell2010
  ghc-options: -Wall

library
  import: common-options
  hs-source-dirs: src
  exposed-modules: API.Routes
                 , Database.Connection
  build-depends: base >= 4.14 && < 5
               , servant >= 0.19
               , servant-server >= 0.19
               , text >= 1.2
               , wai >= 3.2
               , aeson >= 2.0
               , bytestring >= 0.10
               , postgresql-simple >= 0.7 && < 0.8
               , transformers >= 0.5

executable power-system-server
  import: common-options
  hs-source-dirs: app
  main-is: Main.hs
  ghc-options: -threaded -rtsopts -with-rtsopts=-N
  build-depends: base >= 4.14 && < 5
               , power-system
               , warp >= 3.3
