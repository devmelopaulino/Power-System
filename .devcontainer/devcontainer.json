{
  "name": "Power System (Haskell + React)",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "features": {
    "ghcr.io/devcontainers/features/haskell:1": {
      "version": "latest",
      "installGhc": true,
      "installCabal": true,
      "installStack": false
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "haskell.haskell",
        "justusadam.language-haskell",
        "bradlc.vscode-tailwindcss",
        "esbenp.prettier-vscode"
      ]
    }
  },
  "forwardPorts": [8080, 5173],
  "portsAttributes": {
    "5173": { "label": "Power System", "onAutoForward": "notify" },
    "8080": { "label": "API Haskell", "onAutoForward": "silent" }
  },
  "postCreateCommand": "npm --prefix frontend ci && cd backend && cabal update && cabal build"
}
